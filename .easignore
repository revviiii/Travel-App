# EAS archives the repository root for this monorepo. Keep local secrets,
# dependencies, test caches, and generated output out of Android builds.
.git/
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json

**/__pycache__/
**/.venv/
**/venv/
**/.uv-cache/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/

**/node_modules/
**/.expo/
**/.expo-shared/
**/dist/
**/web-build/
**/npm-debug.log*
**/yarn-debug.log*
**/pnpm-debug.log*

supabase/.temp/
supabase/.branches/
.idea/
.vscode/
.kiro/
.DS_Store
Thumbs.db
*.swp
